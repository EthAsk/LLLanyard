{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLLanyard",
  "version": "0.1.5",
  "identifier": "app.lllanyard.desktop",
  "build": { "frontendDist": "../loading" },
  "app": {
    "windows": [{ "label": "main", "title": "LLLanyard", "width": 1040, "height": 780, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "category": "DeveloperTool", "shortDescription": "Keep API keys out of AI agents" }
}
